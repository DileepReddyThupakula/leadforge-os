datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id          String       @id @default(uuid())
  clerkId     String       @unique
  email       String       @unique
  firstName   String?
  lastName    String?
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  auditLogs   AuditLog[]
  sessions    Session[]
  apiKeys     ApiKey[]
  ownedLeads  Lead[]

  @@map("user")
}

model Organization {
  id                 String              @id @default(uuid())
  clerkOrgId         String              @unique
  name               String
  slug               String              @unique
  imageUrl           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  companies          Company[]
  contacts           Contact[]
  leadSources        LeadSource[]
  leadTags           LeadTag[]
  leads              Lead[]
  leadActivities     LeadActivity[]
  notes              Note[]
  conversations      Conversation[]
  aiAnalyses         AIAnalysis[]
  leadQualifications LeadQualification[]

  @@map("organization")
}

model Membership {
  id             String       @id @default(uuid())
  clerkMemberId  String       @unique
  role           Role         @default(MEMBER)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("membership")
}

model AuditLog {
  id             String       @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model ApiKey {
  id             String       @id @default(uuid())
  keyHash        String       @unique
  name           String
  scopes         String[]
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@map("api_key")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  website        String?
  industry       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contacts       Contact[]
  leads          Lead[]

  @@index([organizationId])
  @@map("company")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  leads          Lead[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contact")
}

model LeadSource {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  leads          Lead[]

  @@unique([organizationId, name])
  @@map("lead_source")
}

model LeadTag {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  leads          Lead[]       @relation("LeadToTag")

  @@unique([organizationId, name])
  @@map("lead_tag")
}

model Lead {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  status         LeadStatus     @default(NEW)
  priority       Priority       @default(MEDIUM)
  sourceId       String?
  source         LeadSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  value          Decimal?       @db.Decimal(12, 2)
  currency       String         @default("USD")
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?
  activities     LeadActivity[]
  notes          Note[]
  tags           LeadTag[]      @relation("LeadToTag")
  conversations  Conversation[]
  aiAnalyses     AIAnalysis[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([sourceId])
  @@index([ownerId])
  @@map("lead")
}

model LeadActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String
  description    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@map("lead_activity")
}

model Note {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([leadId])
  @@map("note")
}

model Conversation {
  id                  String              @id @default(uuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId              String?
  lead                Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status              String              @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  messages            Message[]
  leadQualifications  LeadQualification[]
  aiAnalyses          AIAnalysis[]

  @@index([organizationId])
  @@index([leadId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // "USER", "ASSISTANT", "SYSTEM"
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("message")
}

model AIAnalysis {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  intent         String?
  sentiment      String?
  rawResponse    String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([conversationId])
  @@index([leadId])
  @@map("ai_analysis")
}

model LeadQualification {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  propertyType      String?
  budget            Decimal?     @db.Decimal(12, 2)
  location          String?
  timeline          String?
  financing         String?
  purpose           String?
  name              String?
  phone             String?
  email             String?
  score             Int?
  summary           String?
  intent            String?      // HOT, WARM, COLD
  recommendedAction String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([conversationId])
  @@map("lead_qualification")
}
